{
  "name": "nxsoos-company",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n service,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts scripts/launch.ts scripts/integration.ts scripts/hook.ts scripts/diagnostics.ts --bundle --platform=node --format=esm --packages=external --outdir=dist-server --entry-names=[name]",
    "start": "npm run company",
    "company": "node dist-server/launch.js company",
    "visualizer": "node dist-server/launch.js visualizer",
    "stop": "node dist-server/launch.js stop",
    "codex:link": "node dist-server/integration.js link",
    "codex:unlink": "node dist-server/integration.js unlink",
    "codex:status": "node dist-server/integration.js status",
    "codex:diagnose": "node dist-server/diagnostics.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "codex:probe": "tsx scripts/probe.ts",
    "codex:schemas": "tsx scripts/schemas.ts",
    "codex:check": "tsx scripts/command-probe.ts",
    "test:live": "tsx scripts/smoke.ts",
    "test:production": "tsx scripts/production-probe.ts",
    "test:companion": "tsx scripts/companion-proof.ts",
    "format": "prettier --write src server shared scripts tests *.ts *.json README.md docs/*.md"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@radix-ui/react-dialog": "^1.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "pixi.js": "^8.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "smol-toml": "^1.9.1",
    "tailwindcss": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^5.1.0"
  }
}
